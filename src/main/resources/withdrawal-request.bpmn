    <bpmn:sequenceFlow id="Flow_1k1nhms" name="Reject" sourceRef="Gateway_1gwz3h7" targetRef="Gateway_0uvhgne">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${route == 'REJECT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0kj9ibk" name="Manual Review">
      <bpmn:incoming>Flow_11vrvwi</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_11vrvwi" name="Manual review" sourceRef="Gateway_1gwz3h7" targetRef="Event_0kj9ibk">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${route == 'MANUAL_REVIEW'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0bj5ma7" name="Payout">
      <bpmn:incoming>Flow_0rs1lcs</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0rs1lcs" name="Auto approve" sourceRef="Gateway_1gwz3h7" targetRef="Event_0bj5ma7" />
