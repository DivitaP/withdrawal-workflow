  <bpmn:process id="withdrawal-request" name="Retirement Withdrawal Request" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:serviceTask id="Activity_1yykcbo" name="Notify customer : rejected" camunda:expression="${notificationService.send(execution, &#39;REJECTED&#39;)}">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1kn1mia</bpmn:incoming>
      <bpmn:outgoing>Flow_076cnkh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_055s8v1" name="Withdrawal rejected">
      <bpmn:incoming>Flow_076cnkh</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_076cnkh" sourceRef="Activity_1yykcbo" targetRef="Event_055s8v1" />
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_04xhuoo</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_1b0p848" name="Validate request" camunda:delegateExpression="${validateRequestDelegate}">
      <bpmn:incoming>Flow_04xhuoo</bpmn:incoming>
      <bpmn:outgoing>Flow_0rpy5sv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_04xhuoo" sourceRef="StartEvent_1" targetRef="Activity_1b0p848" />
    <bpmn:boundaryEvent id="INVALID_REQUEST" name="Invalid request" attachedToRef="Activity_1b0p848">
      <bpmn:outgoing>Flow_0vv1esa</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1yzh9py" errorRef="Error_0x7l9zq" camunda:errorCodeVariable="INVALID_REQUEST" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_0vv1esa" sourceRef="INVALID_REQUEST" targetRef="Gateway_0uvhgne" />
    <bpmn:parallelGateway id="Gateway_0mo004t">
      <bpmn:incoming>Flow_0rpy5sv</bpmn:incoming>
      <bpmn:outgoing>Flow_1hc7uy1</bpmn:outgoing>
      <bpmn:outgoing>Flow_0lyt65q</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_0rpy5sv" sourceRef="Activity_1b0p848" targetRef="Gateway_0mo004t" />
    <bpmn:serviceTask id="Activity_05j69eo" name="Score fraud risk" camunda:delegateExpression="${fraudCheckDelegate}">
      <bpmn:incoming>Flow_1hc7uy1</bpmn:incoming>
      <bpmn:outgoing>Flow_09fmg83</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1hc7uy1" sourceRef="Gateway_0mo004t" targetRef="Activity_05j69eo" />
    <bpmn:serviceTask id="Activity_02k4q2l" name="Check available balance" camunda:delegateExpression="${balanceCheckDelegate}">
      <bpmn:incoming>Flow_0lyt65q</bpmn:incoming>
      <bpmn:outgoing>Flow_0up0xva</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0lyt65q" sourceRef="Gateway_0mo004t" targetRef="Activity_02k4q2l" />
    <bpmn:parallelGateway id="Gateway_1nqh7hk">
      <bpmn:incoming>Flow_09fmg83</bpmn:incoming>
      <bpmn:incoming>Flow_0up0xva</bpmn:incoming>
      <bpmn:outgoing>Flow_1ck4027</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_09fmg83" sourceRef="Activity_05j69eo" targetRef="Gateway_1nqh7hk" />
    <bpmn:sequenceFlow id="Flow_0up0xva" sourceRef="Activity_02k4q2l" targetRef="Gateway_1nqh7hk" />
    <bpmn:serviceTask id="Activity_0ybqcgk" name="Routing decision" camunda:delegateExpression="${routingDecisionDelegate}">
      <bpmn:incoming>Flow_1ck4027</bpmn:incoming>
      <bpmn:outgoing>Flow_0lr2ogu</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1ck4027" sourceRef="Gateway_1nqh7hk" targetRef="Activity_0ybqcgk" />
    <bpmn:exclusiveGateway id="Gateway_1gwz3h7" name="Route?" default="Flow_0rs1lcs">
      <bpmn:incoming>Flow_0lr2ogu</bpmn:incoming>
      <bpmn:outgoing>Flow_1k1nhms</bpmn:outgoing>
      <bpmn:outgoing>Flow_0rs1lcs</bpmn:outgoing>
      <bpmn:outgoing>Flow_0fczj5t</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0lr2ogu" sourceRef="Activity_0ybqcgk" targetRef="Gateway_1gwz3h7" />
    <bpmn:sequenceFlow id="Flow_1k1nhms" name="Reject" sourceRef="Gateway_1gwz3h7" targetRef="Gateway_0uvhgne">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${route == 'REJECT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0rs1lcs" name="Auto approve" sourceRef="Gateway_1gwz3h7" targetRef="Gateway_1hk4ho3" />
    <bpmn:exclusiveGateway id="Gateway_0uvhgne">
      <bpmn:incoming>Flow_0vv1esa</bpmn:incoming>
      <bpmn:incoming>Flow_1k1nhms</bpmn:incoming>
      <bpmn:incoming>Flow_0ys95oz</bpmn:incoming>
      <bpmn:outgoing>Flow_1kn1mia</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1kn1mia" sourceRef="Gateway_0uvhgne" targetRef="Activity_1yykcbo" />
    <bpmn:userTask id="reviewWithdrawal" name="Review withdrawal" camunda:candidateGroups="reviewers">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="approved" label="Approve withdrawal?" type="boolean" />
          <camunda:formField id="reviewComment" label="Comment" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0fczj5t</bpmn:incoming>
      <bpmn:outgoing>Flow_0dajj9t</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0fczj5t" name="Manual review" sourceRef="Gateway_1gwz3h7" targetRef="reviewWithdrawal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${route == 'MANUAL_REVIEW'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_1tkl0vt" name="Approved?" default="Flow_0ys95oz">
      <bpmn:incoming>Flow_0dajj9t</bpmn:incoming>
      <bpmn:outgoing>Flow_1s5exnz</bpmn:outgoing>
      <bpmn:outgoing>Flow_0ys95oz</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0dajj9t" sourceRef="reviewWithdrawal" targetRef="Gateway_1tkl0vt" />
    <bpmn:sequenceFlow id="Flow_1s5exnz" name="yes" sourceRef="Gateway_1tkl0vt" targetRef="Gateway_1hk4ho3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0ys95oz" name="no" sourceRef="Gateway_1tkl0vt" targetRef="Gateway_0uvhgne">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;rejectionReason&#39;, &#39;Rejected in manual review&#39;)}" event="take" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:boundaryEvent id="Event_0v0m2h3" name="SLA breached" cancelActivity="false" attachedToRef="reviewWithdrawal">
      <bpmn:outgoing>Flow_1dy7o2r</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_01vupf7">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Activity_0k664m8" name="Escalate review" camunda:expression="${notificationService.escalate(execution, &#39;Review SLA breached&#39;)}">
      <bpmn:incoming>Flow_1dy7o2r</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1dy7o2r" sourceRef="Event_0v0m2h3" targetRef="Activity_0k664m8" />
    <bpmn:exclusiveGateway id="Gateway_1hk4ho3" name="Approved merge">
      <bpmn:incoming>Flow_1s5exnz</bpmn:incoming>
      <bpmn:incoming>Flow_0rs1lcs</bpmn:incoming>
      <bpmn:outgoing>Flow_0sspxwl</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_1fwexw1" name="Execute payout" camunda:asyncBefore="true" camunda:delegateExpression="${payoutDelegate}">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R3/PT10S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0sspxwl</bpmn:incoming>
      <bpmn:outgoing>Flow_1bz6y5g</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0sspxwl" sourceRef="Gateway_1hk4ho3" targetRef="Activity_1fwexw1" />
    <bpmn:endEvent id="Event_14g9bw5" name="Withdrawal paid">
      <bpmn:incoming>Flow_1bz6y5g</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1bz6y5g" sourceRef="Activity_1fwexw1" targetRef="Event_14g9bw5" />
  </bpmn:process>
