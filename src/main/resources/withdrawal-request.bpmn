  <bpmn:process id="withdrawal-request" name="Retirement Withdrawal Request" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:serviceTask id="Activity_1yykcbo" name="Notify customer : rejected" camunda:expression="${notificationService.send(execution, &#39;REJECTED&#39;)}">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1kn1mia</bpmn:incoming>
      <bpmn:outgoing>Flow_076cnkh</bpmn:outgoing>
    </bpmn:serviceTask>
